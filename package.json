{
  "name": "yeen",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:server": "kill-port 4000 && npm --prefix apps/server run start:dev",
    "dev:web": "npm --prefix apps/web run dev",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:web\"",
    "build": "npm --prefix apps/server run build && npm --prefix apps/web run build",
    "android:configure-sdk": "node ./scripts/configure-android-local-properties.mjs",
    "android:add": "npm --prefix apps/web run android:add",
    "android:sync": "npm --prefix apps/web run android:sync",
    "android:open": "npm --prefix apps/web run android:open",
    "android:run": "npm --prefix apps/web run android:run",
    "android:tv:list": "npm --prefix apps/web run android:tv:list",
    "android:tv:apk": "npm --prefix apps/web run android:tv:apk",
    "android:tv:live": "npm --prefix apps/web run android:tv:live",
    "dev:web:tv": "npm --prefix apps/web run dev:tv",
    "android:package:publish": "node ./scripts/publish-tv-apk.mjs",
    "android:package:publish:release": "node ./scripts/publish-tv-apk.mjs --release",
    "android:build:debug": "npm --prefix apps/web run android:build:debug && npm run android:package:publish",
    "android:build:release": "npm --prefix apps/web run android:build:release && npm run android:package:publish:release",
    "build:deploy": "npm run build && node ./scripts/prepare-deploy.mjs",
    "build:zip": "npm run build:deploy && node ./scripts/create-zip.mjs",
    "lint": "npm --prefix apps/server run lint && npm --prefix apps/web run lint",
    "line-budget": "node ./scripts/check-line-budget.mjs",
    "line-budget:hard": "node ./scripts/check-line-budget.mjs --hard"
  },
  "devDependencies": {
    "archiver": "^8.0.0",
    "concurrently": "^9.2.1",
    "kill-port": "^2.0.1"
  },
  "description": "Focused media server with NestJS + React"
}
