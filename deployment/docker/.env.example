# Compose controls
YEEN_VERSION=latest
YEEN_HTTP_PORT=4000
# YEEN_IMAGE=ghcr.io/realynx/yeen
# YEEN_DATA_VOLUME=yeen-shared

# Core Yeen runtime. Replace every CHANGE_ME value before starting.
PORT=4000
NODE_ENV=production
CORS_ORIGIN=http://localhost:4000
JWT_SECRET=CHANGE_ME_USE_AT_LEAST_32_RANDOM_CHARACTERS
DEFAULT_ADMIN_EMAIL=admin@yeen.local
DEFAULT_ADMIN_NAME=Yeen Admin
DEFAULT_ADMIN_PASSWORD=CHANGE_ME_BEFORE_FIRST_START
# After the first verified login, delete all three DEFAULT_ADMIN_* lines from
# this host file and recreate the container. The Account persists in the volume.

# Mount host media into the container with a Compose override, then use its
# container path here (for example /media/Movies and /media/TV).
MEDIA_LIBRARY_PATH=/media
MEDIA_LIBRARY_PATHS=/media/Movies;/media/TV
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
OPENSUBTITLES_API_KEY=
TRANSCODE_PRESET=veryfast
TRANSCODE_CRF=22
HLS_SEGMENT_SECONDS=4
SUBTITLE_DEFAULT_LANGUAGE=en
YEEN_ADDONS_ROOT=/opt/yeen/shared/addons
YEEN_ADDON_TRUSTED_KEYS={}
YEEN_SUPERVISED_RESTART=true
