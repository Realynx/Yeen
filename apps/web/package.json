{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner",
    "build": "tsc -b && vite build --configLoader runner && npm run pwa:audit",
    "test": "vitest run",
    "test:broadcast": "vitest run",
    "lint": "eslint . --max-warnings=0 && npm run lint:css:check",
    "lint:fix": "eslint . --fix && npm run lint:css",
    "codefactor:check": "eslint . --max-warnings=0 --rule \"complexity: [error, 15]\" --rule \"no-duplicate-imports: error\"",
    "lint:css": "stylelint \"src/**/*.css\" --fix",
    "lint:css:check": "stylelint \"src/**/*.css\"",
    "preview": "vite preview --configLoader runner",
    "pwa:audit": "node ./scripts/audit-pwa-build.mjs",
    "android:configure-sdk": "node ../../scripts/configure-android-local-properties.mjs",
    "android:audit": "node ../../scripts/android/audit-android-project.mjs",
    "android:test": "node --test ../../scripts/android/*.test.mjs",
    "android:add": "npx cap add android",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "android:run": "npm run build && npx cap run android",
    "android:tv:list": "node ./scripts/run-google-tv-emulator.mjs --list",
    "android:tv:apk": "node ./scripts/run-google-tv-emulator.mjs --mode apk",
    "android:tv:live": "node ./scripts/run-google-tv-emulator.mjs --mode live --host 10.0.2.2 --port 5173",
    "dev:tv": "vite --configLoader runner --host 0.0.0.0 --port 5173",
    "android:build:debug": "npm run android:configure-sdk && npm run build && npx cap sync android && cd android && gradlew assembleDebug",
    "android:build:release": "node ../../scripts/android/verify-release-signing.mjs && npm run android:configure-sdk && npm run build && npx cap sync android && npx cap build android --androidreleasetype APK"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@radix-ui/react-slot": "^1.3.3",
    "@yeen/shared-contracts": "file:../../packages/shared-contracts",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hls.js": "^1.6.14",
    "lucide-react": "^1.33.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^6.30.1",
    "tailwind-merge": "^3.6.0",
    "yeen": "file:../.."
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@capacitor/cli": "^8.3.4",
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.21",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "postcss": "^8.5.6",
    "stylelint": "^16.26.0",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.0.7"
  }
}
