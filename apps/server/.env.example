PORT=4000
# Optional: when both paths are set, this port accepts HTTP and HTTPS together.
# The production systemd installer provisions persistent self-signed files under
# /opt/yeen/shared/tls and sets these automatically.
YEEN_TLS_CERT_PATH=
YEEN_TLS_KEY_PATH=
# Comma-separated list of browser origins allowed for cross-origin API calls.
# Leave empty when web UI is served from the same origin/port as this server.
CORS_ORIGIN=
JWT_SECRET=change-me-for-production
DEFAULT_ADMIN_EMAIL=admin@yeen.local
DEFAULT_ADMIN_NAME=Yeen Admin
DEFAULT_ADMIN_PASSWORD=ChangeMe123!
MEDIA_LIBRARY_PATH=D:/Media
MEDIA_LIBRARY_PATHS=D:/Media/Movies;D:/Media/TV
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
OPENSUBTITLES_API_KEY=
TRANSCODE_PRESET=veryfast
TRANSCODE_CRF=22
HLS_SEGMENT_SECONDS=4
SUBTITLE_DEFAULT_LANGUAGE=en
# Optional absolute path override for Android TV APK served at /api/install/android-tv-apk
# Default fallback when empty: artifacts/tv/yeen-tv.apk
TV_APK_FILE_PATH=

# Persistent Add-on Package storage. Production systemd defaults this to
# /opt/yeen/shared/addons so installed packages survive Core deployments.
YEEN_ADDONS_ROOT=
# JSON map of Ed25519 key IDs to public keys (PEM text or base64 SPKI DER).
# Signed packages are rejected until their publisher key is trusted here.
YEEN_ADDON_TRUSTED_KEYS={}
# Set true only when systemd or another process supervisor will restart Yeen
# after graceful/instant restart requests send SIGTERM.
YEEN_SUPERVISED_RESTART=false

# Core update checks use the stable GitHub Releases channel by default.
# Set `prerelease` only when this installation should opt into preview builds.
YEEN_UPDATE_REPOSITORY=Realynx/Yeen
YEEN_UPDATE_CHANNEL=stable
# Docker deployments are detected and show operator pull/recreate guidance;
# in-app cutover is only enabled for the supported systemd installation.
YEEN_DEPLOYMENT_MODE=
YEEN_UPDATE_MAX_ARCHIVE_BYTES=2147483648
YEEN_UPDATE_GITHUB_TOKEN=
